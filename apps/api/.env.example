# Every variable is optional; leaving one blank uses the default in src/config.ts.
# Nest does not read .env files itself: export these in the shell, or start the
# built server with `node --env-file=.env dist/main.js`.

# Port the HTTP + socket.io server binds to. Default 3001.
PORT=

# Browser origins allowed by CORS, comma separated. Default http://localhost:3000.
WEB_ORIGIN=

# Redis to back room state up to, e.g. redis://localhost:6379. Unset means no persistence.
REDIS_URL=
