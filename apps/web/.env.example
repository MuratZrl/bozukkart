# Every variable is optional; leaving one blank uses the default.
# Copy to .env.local, which Next reads on its own.

# Where the API lives, as the browser sees it. Default http://localhost:3001.
NEXT_PUBLIC_API_URL=

# The public site URL, for absolute URLs in metadata and link previews. Default https://bozukkart.com.
NEXT_PUBLIC_SITE_URL=
